@model IEnumerable<HotelBooking.Models.Room>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rooms & Suites</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css">
    <style>
        body {
            font-family: Arial, sans-serif;
        }

        .room-card {
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
        }

            .room-card:hover {
                transform: translateY(-5px);
            }

        .room-image {
            height: 200px;
            object-fit: cover;
        }

        .room-title {
            font-size: 1.25rem;
            font-weight: bold;
            color: #333;
        }

        .room-price {
            font-size: 1.1rem;
            color: #ff5722;
            font-weight: bold;
        }

        .btn-book {
            background-color: #ff5722;
            color: white;
            font-weight: bold;
            border: none;
        }

            .btn-book:hover {
                background-color: #e64a19;
            }
    </style>
</head>
<body>

    <div class="container my-5">
        <h1 class="text-center mb-5">Rooms & Suites</h1>
        <div class="row g-4">
            <!-- Room 1 -->
             @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="card room-card">
                    <img src="https://via.placeholder.com/400x200" alt="Room 1" class="card-img-top room-image">
                    <div class="card-body">
                        <h5 class="room-title">@item.Name</h5>
                        <p class="text-muted">Max @item.MaxChildrenPeople Childrens - Max @item.MaxAdultPeople Adults</p>
                        <p class="room-price">$@item.Status / Night</p>
                        <p class="room-price">@item.QuantityRoom rooms available</p>
                        <a href="#" class="btn btn-book w-100">Book Now</a>
                    </div>
                </div>
            </div>
            }
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>
