@model HotelBooking.Models.Room
@{
    ViewData["Title"] = "Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JM Family Suite Room</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css">
    <style>
        body {
            font-family: Arial, sans-serif;
        }

        .room-title {
            font-size: 2rem;
            font-weight: bold;
            color: #333;
            margin-bottom: 1rem;
        }

        .feature-list li {
            margin-bottom: 0.5rem;
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .room-image {
            border-radius: 10px 10px 0 0;
            object-fit: cover;
            height: 300px;
        }

        .info-section {
            background-color: #f8f9fa;
            padding: 2rem;
            border-radius: 10px;
        }

        .unique-feature {
            background-color: #ffebd6;
            padding: 1rem;
            border-radius: 8px;
        }
    </style>
</head>
<body>

    <div class="container my-5">
        <div class="row">
            <div class="col-md-8 mx-auto">
                <div class="card">
                    <!-- Image -->
                    <img src="https://via.placeholder.com/800x300" alt="JM Family Suite Room" class="room-image">

                    <div class="card-body">
                        <!-- Title -->
                        <h1 class="room-title">@Model.Name</h1>
                        <div class="info-section">
                            <h3>Room Features</h3>
                            <ul class="list-unstyled">
                                <ul class="list-unstyled feature-list">
                                    @Html.Raw(Model.Features)
                                </ul>
                            </ul>
                            <h3>Policies</h3>
                            <ul class="list-unstyled">
                                <ul class="list-unstyled feature-list">
                                    @Html.Raw(Model.CheckInOut)
                                </ul>
                            </ul>
                            <h3>Room Information</h3>
                            <ul class="list-unstyled">
                                <ul class="list-unstyled feature-list">
                                    @Html.Raw(Model.Amenities)
                                </ul>
                            </ul>
                            <div class="unique-feature mt-3">
                                <h5>Special Amenities</h5>
                                <ul class="list-unstyled">
                                    <h3>Room Features</h3>
                                    <ul class="list-unstyled feature-list">
                                        @Html.Raw(Model.Inclusions)
                                    </ul>
                                </ul>
                            </div>
                            <h3>Others</h3>
                            <ul class="list-unstyled">
                                <ul class="list-unstyled feature-list">
                                    @Html.Raw(Model.Others)
                                </ul>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>
