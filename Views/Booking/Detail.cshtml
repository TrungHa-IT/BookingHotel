@model HotelBooking.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<h1>Booking Details</h1>

<div class="details">
    <div class="form-group">
        <label class="control-label">Booking ID</label>
        <p>@Model.Id</p>
    </div>

    <div class="form-group">
        <label class="control-label">Check-In</label>
        <p>@Model.CheckIn?.ToString("yyyy-MM-dd")</p>
    </div>

    <div class="form-group">
        <label class="control-label">Check-Out</label>
        <p>@Model.CheckOut?.ToString("yyyy-MM-dd")</p>
    </div>

    <div class="form-group">
        <label class="control-label">Quantity of Rooms</label>
        <p>@Model.QuantityRoom</p>
    </div>

    <div class="form-group">
        <label class="control-label">Quantity of Adults</label>
        <p>@Model.QuantityAdult</p>
    </div>

    <div class="form-group">
        <label class="control-label">Quantity of Children</label>
        <p>@Model.QuantityChildren</p>
    </div>

    <div class="form-group">
        <label class="control-label">Quantity of Infants</label>
        <p>@Model.QuantityInfants</p>
    </div>

    <div class="form-group">
        <label class="control-label">First Name</label>
        <p>@Model.FirstName</p>
    </div>

    <div class="form-group">
        <label class="control-label">Last Name</label>
        <p>@Model.LastName</p>
    </div>

    <div class="form-group">
        <label class="control-label">Email</label>
        <p>@Model.Email</p>
    </div>

    <div class="form-group">
        <label class="control-label">Confirm Email</label>
        <p>@Model.ConfirmEmail</p>
    </div>

    <div class="form-group">
        <label class="control-label">Phone</label>
        <p>@Model.Phone</p>
    </div>

    <div class="form-group">
        <label class="control-label">Message</label>
        <p>@Model.Message</p>
    </div>

    <div class="form-group">
        <label class="control-label">Planned Arrival Date</label>
        <p>@Model.PlannedArrivalDate?.ToString("yyyy-MM-dd")</p>
    </div>

    <div class="form-group">
        <label class="control-label">Status</label>
        <p>@Model.Status</p>
    </div>

    <div class="form-group">
        <label class="control-label">Created At</label>
        <p>@Model.CreateAt?.ToString("yyyy-MM-dd")</p>
    </div>

    <div class="form-group">
        <label class="control-label">AppUserId</label>
        <p>@Model.AppUserId</p>
    </div>

    <div class="form-group">
        <label class="control-label">Extras Id</label>
        <p>@Model.ExtrasId</p>
    </div>

    <div class="form-group">
        <label class="control-label">Voucher Id</label>
        <p>@Model.VoucherId</p>
    </div>

    <div class="form-group">
        <label class="control-label">Payment Id</label>
        <p>@Model.PaymentId</p>
    </div>

    <div class="form-group">
        <a href="@Url.Action("Index", "Booking")" class="btn btn-secondary">Back to Booking List</a>
    </div>
</div>
