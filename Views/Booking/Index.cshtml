@model IEnumerable<HotelBooking.Models.Booking>

@{
    ViewData["Title"] = "Booking Index";
}

<h1>Booking List</h1>
<a href="@Url.Action("Create", "Booking")" class="btn btn-success mb-3 align-items-end">Create New Booking</a>

<table class="table">
    <thead>
        <tr>
            <th>Booking ID</th>
            <th>Check-In</th>
            <th>Check-Out</th>
            <th>Quantity of Rooms</th>
            <th>Quantity of Adults</th>
            <th>Quantity of Children</th>
            <th>Quantity of Infants</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Confirm Email</th>
            <th>Phone</th>
            <th>Message</th>
            <th>Planned Arrival Date</th>
            <th>Status</th>
            <th>AppUserId</th>
            <th>ExtrasId</th>
            <th>VoucherId</th>
            <th>PaymentId</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var booking in Model)
        {
            <tr>
                <td>@booking.Id</td>
                <td>@booking.CheckIn?.ToString("yyyy-MM-dd")</td>
                <td>@booking.CheckOut?.ToString("yyyy-MM-dd")</td>
                <td>@booking.QuantityRoom</td>
                <td>@booking.QuantityAdult</td>
                <td>@booking.QuantityChildren</td>
                <td>@booking.QuantityInfants</td>
                <td>@booking.FirstName</td>
                <td>@booking.LastName</td>
                <td>@booking.Email</td>
                <td>@booking.ConfirmEmail</td>
                <td>@booking.Phone</td>
                <td>@booking.Message</td>
                <td>@booking.PlannedArrivalDate?.ToString("yyyy-MM-dd")</td>
                <td>@booking.Status</td>
                <td>@booking.AppUserId</td>
                <td>@booking.ExtrasId</td>
                <td>@booking.VoucherId</td>
                <td>@booking.PaymentId</td>
                <td>
                    <!-- Action Buttons: Edit, Delete, Details -->
                    <a href="@Url.Action("Details", "Booking", new { id = booking.Id })" class="btn btn-info">Details</a>
                    <a href="@Url.Action("Edit", "Booking", new { id = booking.Id })" class="btn btn-warning">Edit</a>
                    <a href="@Url.Action("Delete", "Booking", new { id = booking.Id })" class="btn btn-danger"
                        onclick="return confirm('Are you sure you want to delete this booking?')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
